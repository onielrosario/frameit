# Frame — environment template.
#
# Copy to .env and fill in. `.env` is gitignored; this file is committed and must
# never contain a real value.
#
# Every variable here is SERVER side. No client ever talks to Gemini (CLAUDE.md),
# and the extension bundle is public — nothing in this file may be read by
# apps/extension or apps/web.

# ---- Gemini (services/api only) ----
# Model is configuration, never a literal — architecture.md §8.
# Your own key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A model ID, e.g. a current Flash-class model. Chosen by benchmark, not by size.
FRAME_ANALYSIS_MODEL=

# ---- Limits ----
# 5,000 chars is the locked input limit (SYSTEM-CONTEXT §3).
FRAME_MAX_CONTENT_CHARS=5000
# Spend circuit breaker, Milestone 18. No value chosen yet — it is a measured
# decision, not a guess. Leave blank until there is a real cost number.
FRAME_DAILY_SPEND_CEILING_USD=

# ---- Upstash Redis (REST only — no socket pools, architecture.md §5) ----
# Milestone 18. Blank until then.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Neon Postgres — deferred to Milestone 9 ----
# Serverless HTTP driver, not a connection pool.
DATABASE_URL=

# ---- Local development ----
FRAME_API_BASE_URL=http://127.0.0.1:8000
# CORS allowlist for the dev extension origin. The stable chrome-extension:// ID
# comes from the pinned `key` in manifest.json (apps/extension/docs/CONTEXT.md),
# so this should not need editing on every reload.
FRAME_CORS_ALLOWED_ORIGINS=

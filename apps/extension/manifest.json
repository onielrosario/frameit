{
  "manifest_version": 3,
  "name": "Frame It (dev)",
  "version": "0.0.1",
  "description": "Select text, right click, Frame It. Development build \u2014 no analysis yet.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Frame"
  }
}
